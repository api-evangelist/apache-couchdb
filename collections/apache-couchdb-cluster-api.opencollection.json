{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apache CouchDB HTTP Authentication Cluster API",
    "version": "3.5.1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cluster",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apache CouchDB Get Cluster Setup Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:5984/_cluster_setup"
          },
          "docs": "Returns the current status of the cluster setup process."
        }
      ]
    }
  ],
  "bundled": true
}