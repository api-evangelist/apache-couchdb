{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apache CouchDB HTTP Authentication Replication API",
    "version": "3.5.1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Replication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apache CouchDB Replicate Database",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:5984/_replicate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Initiates a replication task between a source and target database. Can be transient (one-time) or persistent (via _replicator database)."
        }
      ]
    }
  ],
  "bundled": true
}