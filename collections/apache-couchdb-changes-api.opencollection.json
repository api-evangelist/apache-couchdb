{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apache CouchDB HTTP Authentication Changes API",
    "version": "3.5.1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Changes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apache CouchDB Get Database Changes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:5984/:db/_changes",
            "params": [
              {
                "name": "db",
                "value": "mydb",
                "type": "path",
                "description": "Database name."
              },
              {
                "name": "feed",
                "value": "normal",
                "type": "query",
                "description": "Type of changes feed to use."
              },
              {
                "name": "since",
                "value": "0",
                "type": "query",
                "description": "Start sequence number or 'now' for only new changes."
              },
              {
                "name": "limit",
                "value": "25",
                "type": "query",
                "description": "Maximum number of changes to return."
              },
              {
                "name": "include_docs",
                "value": "false",
                "type": "query",
                "description": "Include the document body for each change row."
              },
              {
                "name": "filter",
                "value": "_doc_ids",
                "type": "query",
                "description": "Filter function name (e.g., _doc_ids, _design)."
              }
            ]
          },
          "docs": "Returns a sorted list of changes made to documents in the database, including design documents. The changes feed supports long-polling, continuous, and event-source modes."
        }
      ]
    }
  ],
  "bundled": true
}