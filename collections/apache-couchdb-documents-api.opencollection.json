{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apache CouchDB HTTP Authentication Documents API",
    "version": "3.5.1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Documents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apache CouchDB Get All Documents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:5984/:db/_all_docs",
            "params": [
              {
                "name": "db",
                "value": "mydb",
                "type": "path",
                "description": "Database name."
              },
              {
                "name": "include_docs",
                "value": "true",
                "type": "query",
                "description": "Include the document body for each row."
              },
              {
                "name": "limit",
                "value": "25",
                "type": "query",
                "description": "Maximum number of rows to return."
              },
              {
                "name": "skip",
                "value": "0",
                "type": "query",
                "description": "Number of rows to skip."
              },
              {
                "name": "startkey",
                "value": "\"doc001\"",
                "type": "query",
                "description": "Start key for filtering rows."
              },
              {
                "name": "endkey",
                "value": "\"doc999\"",
                "type": "query",
                "description": "End key for filtering rows."
              },
              {
                "name": "descending",
                "value": "false",
                "type": "query",
                "description": "Return rows in reverse order."
              }
            ]
          },
          "docs": "Returns a built-in view of all documents in the database, supporting key ranges, pagination, and inline document bodies."
        },
        {
          "info": {
            "name": "Apache CouchDB Bulk Get Documents",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:5984/:db/_all_docs",
            "params": [
              {
                "name": "db",
                "value": "mydb",
                "type": "path",
                "description": "Database name."
              },
              {
                "name": "include_docs",
                "value": "true",
                "type": "query",
                "description": "Include full document body."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Fetches multiple documents by their IDs in a single request."
        },
        {
          "info": {
            "name": "Apache CouchDB Get Document",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:5984/:db/:docid",
            "params": [
              {
                "name": "db",
                "value": "mydb",
                "type": "path",
                "description": "Database name."
              },
              {
                "name": "docid",
                "value": "doc001",
                "type": "path",
                "description": "Document ID."
              },
              {
                "name": "rev",
                "value": "1-abc123def456",
                "type": "query",
                "description": "Specific revision ID to retrieve."
              },
              {
                "name": "attachments",
                "value": "false",
                "type": "query",
                "description": "Include attachment data inline (Base64 encoded)."
              }
            ]
          },
          "docs": "Retrieves a document by its ID from the specified database."
        },
        {
          "info": {
            "name": "Apache CouchDB Create or Update Document",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "http://localhost:5984/:db/:docid",
            "params": [
              {
                "name": "db",
                "value": "mydb",
                "type": "path",
                "description": "Database name."
              },
              {
                "name": "docid",
                "value": "doc001",
                "type": "path",
                "description": "Document ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new document or updates an existing one. For updates, the document must include the current _rev value."
        },
        {
          "info": {
            "name": "Apache CouchDB Delete Document",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://localhost:5984/:db/:docid",
            "params": [
              {
                "name": "db",
                "value": "mydb",
                "type": "path",
                "description": "Database name."
              },
              {
                "name": "docid",
                "value": "doc001",
                "type": "path",
                "description": "Document ID."
              },
              {
                "name": "rev",
                "value": "1-abc123def456",
                "type": "query",
                "description": "Current revision of the document."
              }
            ]
          },
          "docs": "Marks a document as deleted by creating a tombstone revision. Requires the current revision via the rev query parameter."
        },
        {
          "info": {
            "name": "Apache CouchDB Bulk Document Operations",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:5984/:db/_bulk_docs",
            "params": [
              {
                "name": "db",
                "value": "mydb",
                "type": "path",
                "description": "Database name."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates, updates, or deletes multiple documents in a single request."
        }
      ]
    }
  ],
  "bundled": true
}