{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apache CouchDB HTTP Authentication Server API",
    "version": "3.5.1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Server",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apache CouchDB Get Server Information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:5984/"
          },
          "docs": "Returns meta information about the CouchDB server instance including version, features, and vendor info."
        },
        {
          "info": {
            "name": "Apache CouchDB Get All Databases",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:5984/_all_dbs",
            "params": [
              {
                "name": "descending",
                "value": "false",
                "type": "query",
                "description": "Return databases in descending order."
              },
              {
                "name": "limit",
                "value": "25",
                "type": "query",
                "description": "Maximum number of results to return."
              },
              {
                "name": "skip",
                "value": "0",
                "type": "query",
                "description": "Number of results to skip before returning."
              }
            ]
          },
          "docs": "Returns a list of all databases in the CouchDB instance."
        }
      ]
    }
  ],
  "bundled": true
}