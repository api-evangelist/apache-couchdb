                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"selector\": \"<object>\",\n  \"fields\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"limit\": 25,\n  \"skip\": 0,\n  \"sort\": [\n    \"<object>\",\n    \"<object>\"\n  ],\n  \"bookmark\": \"<string>\"\n}",
