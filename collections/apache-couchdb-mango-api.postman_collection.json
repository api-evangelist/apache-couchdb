          "name": "Apache CouchDB Find Documents (Mango Query)",
          "request": {
            "name": "Apache CouchDB Find Documents (Mango Query)",
            "description": {
              "content": "Executes a Mango (declarative JSON) query against the database to find documents matching specified criteria.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":db",
                "_find"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "db",
                  "description": "(Required) Database name."
                }
              ]
