          "name": "Apache CouchDB Get View Results",
          "request": {
            "name": "Apache CouchDB Get View Results",
            "description": {
              "content": "Executes a MapReduce view defined in a design document and returns the results.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":db",
                "_design",
                ":ddoc",
                "_view",
                ":view"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "include_docs",
                  "value": "false",
                  "description": "Include the full document body for each row."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of rows to return."
                },
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "Return only rows matching the specified key."
                },
                {
                  "disabled": false,
                  "key": "reduce",
                  "value": "<boolean>",
                  "description": "Execute the reduce function."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "db",
                  "description": "(Required) Database name."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "ddoc",
                  "description": "(Required) Design document name (without _design/ prefix)."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "view",
                  "description": "(Required) View name within the design document."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
